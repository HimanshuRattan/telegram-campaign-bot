# From @BotFather
TELEGRAM_BOT_TOKEN=

# The long id in the Sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Service account key: a file path for local runs, or the file's JSON contents for hosted runs.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Claude access: set ONE of these. OpenRouter is used if its key is set.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Timezone used for send_at and deadlines in the Sheet
TIMEZONE=Asia/Kolkata

# Optional
# ADMIN_GROUP_ID=   (normally linked with /setup instead)
# CLAUDE_MODEL=claude-opus-5-5   (OpenRouter format: anthropic/claude-opus-5.5)
# CLAUDE_EFFORT=low
# DB_PATH=data/bot.db
